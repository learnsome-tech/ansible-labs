{
  "name": "Ansible Configuration Management at Scale labs",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "vscode",
  "updateRemoteUserUID": false,
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md"
      ]
    },
    "vscode": {
      "extensions": [
        "redhat.vscode-yaml",
        "timonwong.shellcheck"
      ]
    }
  }
}
